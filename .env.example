# --- Выбор хостинга ---
GIT_PROVIDER=github            # github | gitlab

# --- YouGile ---
YOUGILE_BEARER_TOKEN=          # Настройки -> API -> создать ключ
YOUGILE_PROJECT_ID=
YOUGILE_BOARD_ID=
YOUGILE_COLUMN_ID=             # колонка, за которой ведётся наблюдение
YOUGILE_POLL_INTERVAL=10       # период опроса в секундах

# --- GitHub (если GIT_PROVIDER=github) ---
GITHUB_TOKEN=                  # Personal Access Token со scope "repo"
GITHUB_REPO=                   # owner/repo, например rlxlxl/AutoAgile
GITHUB_WEBHOOK_SECRET=         # та же строка в настройках вебхука GitHub

# --- GitLab (если GIT_PROVIDER=gitlab) ---
GITLAB_TOKEN=                  # Personal/Project Access Token со scope "api"
GITLAB_URL=http://localhost:8929
GITLAB_PROJECT_ID=             # числовой ID проекта или group%2Fproject
GITLAB_WEBHOOK_TOKEN=          # та же строка в поле Secret token вебхука GitLab

# --- Секрет вебхуков YouGile ---
YOUGILE_WEBHOOK_SECRET=        # оставить пустым: YouGile не подписывает вебхуки
